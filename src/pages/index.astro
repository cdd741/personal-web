---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import HomeGrid from '../components/HomeGrid.astro';
import { SITE } from '../site.config';
---

<Base>
  <script is:inline slot="head">
    // The old site used hash routes (/#/about, /#/photo); send those visitors somewhere sensible.
    if (location.hash.startsWith('#/')) {
      location.replace(location.hash.slice(2).replace(/\/$/, '') === 'about' ? '/about/' : '/');
    }
  </script>

  <Hero />

  <div class="sheet" data-ocean-sheet>
    <div class="container-wide intro">
      <p class="still">This is where I keep things I've built, the occasional piece of writing, and a few toys.</p>
      <ul class="links">
        <li><a href={SITE.links.github} rel="me" style="--c: var(--c-violet)">GitHub ↗</a></li>
        {SITE.links.linkedin && <li><a href={SITE.links.linkedin} rel="me" style="--c: var(--c-cyan)">LinkedIn ↗</a></li>}
        <li><a href="/about/" style="--c: var(--c-amber)">More about me →</a></li>
      </ul>
    </div>

    <HomeGrid />
  </div>
</Base>

<script>
  // Reveal the intro and the home cards as they scroll into view, staggered left to right.
  // Anything already on screen at load is left alone, and so is everything under reduced motion.
  const targets = document.querySelectorAll<HTMLElement>('[data-ocean-sheet] .intro, [data-ocean-sheet] .card');
  if (targets.length && 'IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const observer = new IntersectionObserver(
      (entries) => {
        const entering = entries.filter((e) => e.isIntersecting).sort((a, b) => a.boundingClientRect.left - b.boundingClientRect.left);
        entering.forEach((entry, i) => {
          const el = entry.target as HTMLElement;
          observer.unobserve(el);
          el.style.setProperty('--reveal-delay', `${i * 90}ms`);
          el.classList.add('in');
          // Hand the element back to its own hover transitions once it has settled.
          const settle = (e: TransitionEvent) => {
            if (e.target !== el || e.propertyName !== 'translate') return;
            el.removeEventListener('transitionend', settle);
            el.classList.remove('reveal', 'in');
          };
          el.addEventListener('transitionend', settle);
        });
      },
      { rootMargin: '0px 0px -8% 0px', threshold: 0.12 },
    );
    for (const el of targets) {
      if (el.getBoundingClientRect().top < window.innerHeight) continue;
      el.classList.add('reveal');
      observer.observe(el);
    }
  }
</script>

<style>
  /* The rest of the page is a sheet of paper that slides up over the pinned ocean. It
     starts as a rounded card with water showing on both sides, and Hero.astro raises
     --open from 0 to 1 on scroll to widen it to the full page. The inset never reaches
     the content. */
  .sheet {
    --open: 0;
    --side: calc((100vw - min(100vw - 2 * var(--gutter), var(--wide))) / 2);
    --inset: calc(min(9rem, var(--side) - 0.5rem) * (1 - var(--open)));
    --corner: calc(1.75rem * (1 - var(--open)));
    position: relative;
    z-index: 1;
    /* The gap is scroll distance during which the ocean stays pinned and its scenes play. */
    margin-top: 120svh;
    background: var(--bg);
    clip-path: inset(0 var(--inset) 0 var(--inset) round var(--corner) var(--corner) 0 0);
  }

  /* Cards rise into place the first time they scroll into view (see the script below). */
  :global(.reveal) {
    opacity: 0;
    translate: 0 2.25rem;
    scale: 0.97;
  }

  :global(.reveal.in) {
    opacity: 1;
    translate: 0 0;
    scale: 1;
    transition:
      opacity 0.8s var(--ease-out) var(--reveal-delay, 0ms),
      translate 0.8s var(--ease-out) var(--reveal-delay, 0ms),
      scale 0.8s var(--ease-out) var(--reveal-delay, 0ms);
  }

  .intro {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding-top: 2.75rem;
  }

  /* The sentence plays over the ocean; it only appears here when that animation is off. */
  .intro .still {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .sheet {
      margin-top: -1.75rem;
    }

    .intro .still {
      display: block;
    }
  }

  .intro p {
    margin: 0;
    max-width: 34rem;
    font-size: var(--step-1);
    line-height: 1.5;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--step--1);
  }

  .links a {
    display: inline-block;
    padding: 0.4rem 0.9rem;
    border: 1px solid color-mix(in oklab, var(--c) 35%, var(--border));
    border-radius: 999px;
    background: color-mix(in oklab, var(--c) 8%, transparent);
    color: color-mix(in oklab, var(--c) 70%, var(--fg));
    text-decoration: none;
    transition:
      background-color 0.2s,
      box-shadow 0.2s,
      transform 0.2s var(--ease-out);
  }

  .links a:hover {
    background: color-mix(in oklab, var(--c) 16%, transparent);
    box-shadow: 0 0 20px -4px color-mix(in oklab, var(--c) 55%, transparent);
    transform: translateY(-1px);
  }
</style>
