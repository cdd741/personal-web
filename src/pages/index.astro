---
import Base from '../layouts/Base.astro';
import OceanBackdrop from '../components/home/OceanBackdrop.astro';
import Scene from '../components/home/Scene.astro';
import SceneGreeting from '../components/home/SceneGreeting.astro';
import SceneStatement from '../components/home/SceneStatement.astro';
import SceneWork from '../components/home/SceneWork.astro';
import SceneNumbers from '../components/home/SceneNumbers.astro';
import SceneProject from '../components/home/SceneProject.astro';
import SceneGithub from '../components/home/SceneGithub.astro';
import Seabed from '../components/home/Seabed.astro';
import '../styles/dive.css';
---

<Base>
  <script is:inline slot="head">
    // The old site used hash routes (/#/about, /#/photo); send those visitors somewhere sensible.
    if (location.hash.startsWith('#/')) {
      location.replace(location.hash.slice(2).replace(/\/$/, '') === 'about' ? '/about/' : '/');
    }
  </script>

  <!-- The home page is one dive, from the surface to the seabed. Each scene is a screen
       that pins while its animation plays; `hold` is how long, in screens. The sharks
       and the amount of fish change with depth. scripts/dive runs it all. -->
  <div class="dive theme-dark" data-dive>
    <OceanBackdrop />
    <div class="scenes">
      <Scene name="greeting" hold={0.4} sharks="mako,classic" fish={1}>
        <SceneGreeting />
      </Scene>
      <Scene name="statement" hold={0.8} sharks="mako,classic" fish={1}>
        <SceneStatement />
      </Scene>
      <Scene name="work" hold={1.6} sharks="hammerhead,thresher" fish={0.8} label="Work">
        <SceneWork />
      </Scene>
      <Scene name="numbers" hold={0.8} sharks="thresher,hammerhead" fish={0.65} label="By the numbers">
        <SceneNumbers />
      </Scene>
      <Scene name="project" hold={1} sharks="tiger" fish={0.5} label="Featured project">
        <SceneProject />
      </Scene>
      <Scene name="github" hold={0.8} sharks="tiger" fish={0.4} label="GitHub activity">
        <SceneGithub />
      </Scene>
      <Seabed />
    </div>
  </div>
</Base>

<script>
  import { startDive } from '../scripts/dive';

  const root = document.querySelector<HTMLElement>('[data-dive]');
  if (root) startDive(root);
</script>
