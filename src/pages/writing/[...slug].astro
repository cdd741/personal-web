---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { getPosts } from '../../lib';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, pubDate, updatedDate, tags, draft } = post.data;
---

<Base title={title} description={description} type="article">
  <article class="container">
    <header class="post-head">
      <a class="back" href="/writing/">← Writing</a>
      <h1>{title}</h1>
      <p class="meta mono">
        <FormattedDate date={pubDate} />
        {
          updatedDate && (
            <span>
              · updated <FormattedDate date={updatedDate} />
            </span>
          )
        }
        {tags.map((t) => <span class="badge">{t}</span>)}
        {draft && <span class="badge badge-draft">draft</span>}
      </p>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>

<style>
  .post-head {
    padding-block: clamp(2rem, 6vw, 4rem) 2rem;
  }

  .back {
    font-size: var(--step--1);
    color: var(--fg-muted);
    text-decoration: none;
  }

  .back:hover {
    color: var(--accent);
  }

  h1 {
    margin: 1rem 0 0.75rem;
    font-size: var(--step-3);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    color: var(--fg-faint);
    font-size: 0.8rem;
  }
</style>
