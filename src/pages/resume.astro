---
import Base from '../layouts/Base.astro';
import { getProjects } from '../lib';
import { RESUME, RESUME_PDF } from '../resume';

const projects = (await getProjects()).filter((p) => p.data.featured).slice(0, 3);
const { name, headline, location, contacts, summary, experience, education, skills } = RESUME;
---

<Base title="Résumé" description={`${name}: ${headline}. One-page résumé, also available as a PDF.`}>
  <div class="container-wide toolbar">
    <div>
      <h1>Résumé</h1>
      <p class="muted">One page. Also as a PDF, sized for US Letter.</p>
    </div>
    <div class="actions">
      <a class="btn btn-primary" href={RESUME_PDF} download data-download>Download PDF ↓</a>
      <button class="btn" type="button" data-print>Print</button>
    </div>
  </div>

  <div class="sheet-wrap">
    <article class="sheet" aria-label={`${name}'s résumé`}>
      <header class="head">
        <div>
          <h2 class="name">{name}</h2>
          <p class="headline">{headline} · {location}</p>
        </div>
        <ul class="contacts">
          {
            contacts
              .filter((c) => c.href)
              .map((c) => (
                <li>
                  <a href={c.href}>{c.label}</a>
                </li>
              ))
          }
        </ul>
      </header>

      <p class="summary">{summary}</p>

      <section>
        <h3>Experience</h3>
        {
          experience.map((job) => (
            <div class="entry">
              <div class="entry-head">
                <p>
                  <strong>{job.role}</strong>
                  {' · '}
                  {job.url ? <a href={job.url}>{job.company}</a> : job.company}
                </p>
                <p class="when">
                  {job.start} – {job.end}
                </p>
              </div>
              <p class="where">{job.location}</p>
              <ul>
                {job.bullets.map((b) => (
                  <li>{b}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </section>

      {
        projects.length > 0 && (
          <section>
            <h3>Projects</h3>
            {projects.map(({ data }) => (
              <div class="entry entry-compact">
                <div class="entry-head">
                  <p>
                    <strong>{(data.url ?? data.repo) ? <a href={data.url ?? data.repo}>{data.title}</a> : data.title}</strong>
                    {' · '}
                    <span class="soft">{data.description}</span>
                  </p>
                  <p class="when">{data.year}</p>
                </div>
              </div>
            ))}
          </section>
        )
      }

      <section>
        <h3>Education</h3>
        {
          education.map((ed) => (
            <div class="entry entry-compact">
              <div class="entry-head">
                <p>
                  <strong>{ed.degree}</strong>
                  {' · '}
                  {ed.school}
                </p>
                <p class="when">{ed.end}</p>
              </div>
              <p class="where">{ed.location}</p>
            </div>
          ))
        }
      </section>

      <section>
        <h3>Skills</h3>
        <dl class="skills">
          {
            skills.map((s) => (
              <div>
                <dt>{s.label}</dt>
                <dd>{s.items.join(' · ')}</dd>
              </div>
            ))
          }
        </dl>
      </section>
    </article>
  </div>
</Base>

<script>
  document.querySelector('[data-print]')?.addEventListener('click', () => window.print());

  // The PDF is generated in CI; when it's missing (local dev), fall back to printing.
  document.querySelector<HTMLAnchorElement>('[data-download]')?.addEventListener('click', async (e) => {
    const link = e.currentTarget as HTMLAnchorElement;
    if (link.dataset.checked) return;
    e.preventDefault();
    const res = await fetch(link.href, { method: 'HEAD' }).catch(() => null);
    if (res?.ok && res.headers.get('content-type')?.includes('pdf')) {
      link.dataset.checked = '1';
      link.click();
    } else {
      window.print();
    }
  });
</script>

<style>
  /* ---------- screen chrome ---------- */
  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding-block: clamp(2rem, 6vw, 4rem) 1.5rem;
  }

  .toolbar h1 {
    margin: 0 0 0.35rem;
    font-size: var(--step-3);
  }

  .toolbar p {
    margin: 0;
  }

  .actions {
    display: flex;
    gap: 0.6rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: 0.55rem 1.1rem;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: var(--bg-raised);
    color: var(--fg);
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
    transition:
      transform 0.2s var(--ease-out),
      box-shadow 0.2s;
  }

  .btn:hover {
    color: var(--fg);
    transform: translateY(-1px);
  }

  .btn-primary {
    border-color: transparent;
    background: var(--trail);
    color: #fff;
    box-shadow: 0 8px 24px -10px color-mix(in oklab, var(--c-red) 70%, transparent);
  }

  .btn-primary:hover {
    color: #fff;
    box-shadow: 0 12px 30px -10px color-mix(in oklab, var(--c-red) 85%, transparent);
  }

  .sheet-wrap {
    width: min(100% - 2 * var(--gutter), 8.5in);
    margin-inline: auto;
  }

  /* ---------- the paper: fixed colors, identical on screen, in print and in the PDF ---------- */
  .sheet {
    --ink: #1c1814;
    --ink-soft: #5b534a;
    --ink-faint: #8b8278;
    --rule: #e9e2d6;
    --amber: #e8900c;
    --red: #e0403a;
    --pink: #db3f86;

    padding: 0.6in 0.65in;
    border-radius: 6px;
    background: #fff;
    color: var(--ink);
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.06),
      0 24px 60px -24px rgb(40 20 10 / 0.35);
    font-size: 10pt;
    line-height: 1.45;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }

  .sheet p {
    margin: 0;
  }

  .sheet a {
    color: inherit;
    text-decoration: none;
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.6rem 1.5rem;
    padding-bottom: 0.9em;
    border-bottom: 2px solid transparent;
    border-image: linear-gradient(90deg, var(--amber), var(--red) 55%, var(--pink)) 1;
  }

  .name {
    margin: 0;
    font-size: 24pt;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .headline {
    margin-top: 0.3em !important;
    color: var(--ink-soft);
    font-size: 11pt;
  }

  .contacts {
    display: grid;
    gap: 0.15em;
    margin: 0;
    padding: 0;
    list-style: none;
    text-align: right;
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: 8.5pt;
    color: var(--ink-soft);
  }

  .summary {
    margin-top: 1.1em !important;
    color: var(--ink-soft);
  }

  section {
    margin-top: 1.3em;
  }

  h3 {
    display: flex;
    align-items: center;
    gap: 0.6em;
    margin: 0 0 0.6em;
    font-size: 8.5pt;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--red);
  }

  h3::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--rule);
  }

  .entry + .entry {
    margin-top: 0.9em;
  }

  .entry-compact + .entry-compact {
    margin-top: 0.45em;
  }

  .entry-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1em;
  }

  .when {
    flex: none;
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: 8.5pt;
    color: var(--ink-faint);
  }

  .where {
    font-size: 9pt;
    color: var(--ink-faint);
  }

  .soft {
    color: var(--ink-soft);
  }

  .entry ul {
    margin: 0.35em 0 0;
    padding-left: 1.1em;
  }

  .entry li {
    padding-left: 0.2em;
  }

  .entry li::marker {
    color: var(--amber);
  }

  .entry li + li {
    margin-top: 0.2em;
  }

  .skills {
    display: grid;
    gap: 0.3em;
    margin: 0;
  }

  .skills div {
    display: grid;
    grid-template-columns: 7em 1fr;
    gap: 1em;
  }

  .skills dt {
    font-weight: 600;
  }

  .skills dd {
    margin: 0;
    color: var(--ink-soft);
  }

  @media (max-width: 640px) {
    .sheet {
      padding: 1.5rem 1.25rem;
    }

    .contacts {
      text-align: left;
    }

    .entry-head {
      flex-direction: column;
      gap: 0;
    }
  }

  /* ---------- print / PDF: just the sheet, edge to edge on US Letter ---------- */
  @page {
    size: letter;
    margin: 0;
  }

  @media print {
    .toolbar {
      display: none;
    }

    .sheet-wrap {
      width: auto;
    }

    .sheet {
      width: 8.5in;
      min-height: 11in;
      padding: 0.6in 0.65in;
      border-radius: 0;
      box-shadow: none;
    }
  }
</style>
