---
import { NAV, SITE } from '../site.config';

const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(href);
---

<header class="site-header container-wide">
  <a class="wordmark" href="/" aria-label={`${SITE.name}, home`}>
    <span class="tail-light" aria-hidden="true"></span>
    {SITE.name}
  </a>

  <nav aria-label="Main">
    <ul>
      {
        NAV.map(({ href, label }) => (
          <li>
            <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="actions">
    <button type="button" class="icon-btn cmdk-btn" data-cmdk-open aria-label="Open command palette" aria-keyshortcuts="Meta+K Control+K">
      <kbd data-mod-key>⌘</kbd><kbd>K</kbd>
    </button>
    <button type="button" class="icon-btn" data-theme-toggle aria-label="Toggle dark mode">
      <svg class="moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11Z"></path>
      </svg>
      <svg class="sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
      </svg>
    </button>
  </div>
</header>

<script>
  import { toggleTheme } from '../scripts/theme';

  document.querySelector('[data-theme-toggle]')?.addEventListener('click', toggleTheme);

  if (!/Mac|iPhone|iPad/.test(navigator.platform || navigator.userAgent)) {
    document.querySelectorAll('[data-mod-key]').forEach((el) => (el.textContent = 'Ctrl'));
  }
</script>

<style>
  .site-header {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding-block: 1.25rem;
    font-size: 0.9375rem;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
    white-space: nowrap;
  }

  .tail-light {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow:
      0 0 6px 1px color-mix(in oklab, var(--accent) 70%, transparent),
      0 0 18px 4px color-mix(in oklab, var(--accent) 25%, transparent);
    transition: transform 0.3s var(--ease-out);
  }

  .wordmark:hover .tail-light {
    transform: scale(1.25);
  }

  nav {
    margin-left: auto;
  }

  nav ul {
    display: flex;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    display: block;
    padding: 0.35rem 0.6rem;
    border-radius: var(--radius-sm);
    color: var(--fg-muted);
    text-decoration: none;
    transition: color 0.15s, background-color 0.15s;
  }

  nav a:hover {
    color: var(--fg);
    background: var(--accent-soft);
  }

  nav a[aria-current='page'] {
    color: var(--fg);
  }

  nav a[aria-current='page']::after {
    content: '';
    display: block;
    height: 2px;
    margin-top: 2px;
    border-radius: 2px;
    background: var(--trail);
    box-shadow: 0 0 8px color-mix(in oklab, var(--c-red) 50%, transparent);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.2rem;
    min-width: 2.25rem;
    height: 2.25rem;
    padding: 0 0.4rem;
    border: 0;
    border-radius: var(--radius-sm);
    background: none;
    color: var(--fg-muted);
    cursor: pointer;
    transition: color 0.15s, background-color 0.15s;
  }

  .icon-btn:hover {
    color: var(--fg);
    background: var(--accent-soft);
  }

  .cmdk-btn kbd {
    font-size: 0.7rem;
  }

  .sun {
    display: none;
  }

  :global(:root[data-theme='dark']) .sun {
    display: block;
  }

  :global(:root[data-theme='dark']) .moon {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .sun {
      display: block;
    }

    :global(:root:not([data-theme='light'])) .moon {
      display: none;
    }
  }

  @media (max-width: 620px) {
    .site-header {
      flex-wrap: wrap;
      row-gap: 0.5rem;
    }

    .actions {
      margin-left: auto;
    }

    nav {
      order: 3;
      flex-basis: 100%;
      margin-left: -0.6rem;
    }
  }

  @media (hover: none) {
    .cmdk-btn {
      display: none;
    }
  }
</style>
