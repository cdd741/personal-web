---
import type { CollectionEntry } from 'astro:content';
import { tagStyle } from '../tag-color';

interface Props {
  projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;
---

{
  projects.length ? (
    <ul class="projects">
      {projects.map(({ data }) => {
        const href = data.url ?? data.repo;
        return (
          <li style={tagStyle(data.tags[0] ?? data.title)}>
            <div class="row">
              <h3>
                {href ? <a href={href}>{data.title}</a> : data.title}
                {data.draft && <span class="badge badge-draft">draft</span>}
              </h3>
              <span class="year mono">{data.year}</span>
            </div>
            {data.awards.length > 0 && (
              <p class="awards">
                {data.awards.map((a, i) => (
                  <span class={i === 0 ? 'badge badge-award' : 'badge'}>{a}</span>
                ))}
              </p>
            )}
            <p>{data.description}</p>
            {(data.tags.length > 0 || (data.url && data.repo) || data.links.length > 0 || data.team) && (
              <p class="meta">
                {data.tags.map((t) => (
                  <span class="badge badge-tag" style={tagStyle(t)}>
                    {t}
                  </span>
                ))}
                {data.url && data.repo && <a href={data.repo}>source</a>}
                {data.links.map((l) => (
                  <a href={l.href}>{l.label}</a>
                ))}
                {data.team && <span class="team">{[data.team, data.role].filter(Boolean).join(' · ')}</span>}
              </p>
            )}
          </li>
        );
      })}
    </ul>
  ) : (
    <p class="empty">Projects are being dusted off. Check back soon.</p>
  )
}

<style>
  .projects {
    display: grid;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    padding: 1rem 0;
    border-bottom: 1px solid var(--border);
  }

  li:first-child {
    border-top: 1px solid var(--border);
  }

  .row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  h3 {
    margin: 0;
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  h3 a {
    text-decoration: none;
  }

  h3 a::after {
    content: ' ↗';
    color: var(--fg-faint);
    font-weight: 400;
    transition: color 0.15s;
  }

  h3 a:hover {
    color: color-mix(in oklab, var(--tag) 85%, var(--fg));
    text-decoration: none;
  }

  h3 a:hover::after {
    color: var(--tag);
  }

  .badge {
    margin-left: 0.4rem;
  }

  .meta .badge {
    margin: 0 0.35rem 0 0;
  }

  .year {
    color: var(--fg-faint);
    font-size: 0.8rem;
  }

  p {
    margin: 0.3rem 0 0;
    color: var(--fg-muted);
  }

  .awards {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.45rem;
  }

  .awards .badge {
    margin: 0;
  }

  .team {
    color: var(--fg-faint);
  }

  .meta > * + .team::before {
    content: '·';
    margin-right: 0.4rem;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem;
    margin-top: 0.6rem;
    font-size: 0.8rem;
  }
</style>
