---
import { SITE } from '../site.config';
---

<!-- A full-bleed ASCII ocean behind the top of the home page. On scroll, the water
     moves at half speed and the greeting at three-quarter speed, so the page below
     slides up over them. -->
<section class="ocean" aria-labelledby="hero-title" data-ocean-section>
  <div class="water" data-ocean-water>
    <canvas data-ocean aria-hidden="true"></canvas>
  </div>
  <div class="scrim" aria-hidden="true"></div>
  <div class="copy container-wide" data-ocean-copy>
    <h1 id="hero-title">Hi, I'm Andre.</h1>
    <p class="role">
      {SITE.role} at <a href={SITE.company.url}>{SITE.company.name}</a>.
    </p>
    <p class="caption mono">
      <span class="hint-mouse">Fish scatter from your cursor. Click to splash.</span>
      <span class="hint-touch">Tap the water to splash.</span>
      <a href="https://github.com/stackedlol/ascii-sharks" rel="noopener">ascii-sharks ↗</a>
    </p>
  </div>
</section>

<script>
  import { OceanEngine, type SharkSpec } from '../vendor/ascii-sharks';

  const section = document.querySelector<HTMLElement>('[data-ocean-section]');
  const water = document.querySelector<HTMLElement>('[data-ocean-water]');
  const copy = document.querySelector<HTMLElement>('[data-ocean-copy]');
  const canvas = document.querySelector<HTMLCanvasElement>('[data-ocean]');

  if (section && water && copy && canvas) {
    // Fewer sharks on narrow screens, so the schools of fish still have room.
    const narrow = canvas.getBoundingClientRect().width < 640;
    const sharks: SharkSpec[] = narrow
      ? [
          { kind: 'hammerhead', size: 1 },
          { kind: 'mako', size: 0.8 },
        ]
      : [
          { kind: 'hammerhead', size: 1 },
          { kind: 'thresher', size: 0.9 },
          { kind: 'mako', size: 0.8 },
          { kind: 'tiger', size: 0.72 },
        ];
    new OceanEngine(canvas, sharks);

    // Parallax. Skipped for visitors who prefer reduced motion.
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    let queued = false;
    const update = () => {
      queued = false;
      const height = section.offsetHeight;
      const y = reduced.matches ? 0 : Math.min(Math.max(window.scrollY, 0), height);
      water.style.transform = `translate3d(0, ${(y * 0.5).toFixed(1)}px, 0)`;
      copy.style.transform = `translate3d(0, ${(y * 0.25).toFixed(1)}px, 0)`;
      copy.style.opacity = String(Math.max(0, 1 - y / (height * 0.55)));
    };
    const onScroll = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(update);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    reduced.addEventListener('change', onScroll);
    update();
  }
</script>

<style>
  .ocean {
    position: relative;
    height: 100svh;
    min-height: 30rem;
    overflow: hidden;
    background: #000;
    color: #f4f2ee;
    cursor: crosshair;
  }

  .water,
  .scrim {
    position: absolute;
    inset: 0;
  }

  .water {
    will-change: transform;
  }

  /* The ASCII glyphs are drawn in the canvas's own font, so it has to be monospace. */
  canvas {
    display: block;
    width: 100%;
    height: 100%;
    font-family: var(--font-mono), ui-monospace, Menlo, monospace;
  }

  /* Darkens the top for the header and the bottom for the greeting. */
  .scrim {
    background:
      linear-gradient(to bottom, rgb(0 0 0 / 0.6), rgb(0 0 0 / 0) 9rem),
      linear-gradient(to top, rgb(0 0 0 / 0.85), rgb(0 0 0 / 0) 50%);
    pointer-events: none;
  }

  .copy {
    position: absolute;
    inset: auto 0 clamp(3.5rem, 9vh, 6rem);
    pointer-events: none;
    text-shadow: 0 1px 14px rgb(0 0 0 / 0.8);
    will-change: transform, opacity;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.75rem, 1.5rem + 6vw, 5.5rem);
    letter-spacing: -0.035em;
    line-height: 1;
  }

  .role {
    margin: 0.9rem 0 0;
    font-size: var(--step-1);
    color: rgb(244 242 238 / 0.78);
  }

  .caption {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin: 1.4rem 0 0;
    font-size: 0.75rem;
    color: rgb(244 242 238 / 0.5);
  }

  .copy a {
    pointer-events: auto;
    color: inherit;
    text-decoration-color: rgb(255 255 255 / 0.35);
  }

  .caption a {
    color: rgb(244 242 238 / 0.7);
    text-decoration: none;
  }

  .copy a:hover {
    color: #fff;
    text-decoration-color: var(--accent);
  }

  .hint-touch {
    display: none;
  }

  @media (hover: none) {
    .hint-mouse {
      display: none;
    }

    .hint-touch {
      display: inline;
    }
  }

  /* The site header sits on top of the water on this page, in light text. */
  :global(body:has(.ocean) .site-header) {
    position: absolute;
    inset: 0 0 auto;
    z-index: 2;
    --fg: #f4f2ee;
    --fg-muted: rgb(244 242 238 / 0.72);
    --accent-soft: rgb(255 255 255 / 0.12);
    --bg-raised: rgb(255 255 255 / 0.08);
    --border-strong: rgb(255 255 255 / 0.28);
    color: var(--fg);
  }
</style>
